{
  "name": "archie",
  "version": "0.1.0-private.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/sync-product-version.mjs && node scripts/bundle-html-design-checker.mjs && tsc -p tsconfig.build.json && node scripts/stage-package-dist.mjs",
    "test": "npm run build --silent && node scripts/run-tests.mjs",
    "test:architecture-docs": "npm run test --workspace @archie/architecture-docs",
    "test:html-design": "npm run test --workspace @archie/html-design",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "node scripts/check-package-content.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "private-trial:evaluate": "npm run build --silent && node scripts/run-private-trial-evaluation.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "typescript": "7.0.2"
  }
}
