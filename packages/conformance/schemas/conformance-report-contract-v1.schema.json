{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"conformance-report-contract/v1","title":"Architecture Conformance consumer report contract v1","type":"object","additionalProperties":false,"required":["version","report","state"],
  "properties":{"version":{"const":"conformance-report-contract/v1"},"report":{"$ref":"#/$defs/report"},"state":{"$ref":"#/$defs/state"}},
  "$defs":{
    "nonEmpty":{"type":"string","minLength":1},"digest":{"$ref":"#/$defs/nonEmpty"},
    "input":{"type":"object","additionalProperties":false,"required":["kind","path","digest"],"properties":{"kind":{"$ref":"#/$defs/nonEmpty"},"path":{"$ref":"#/$defs/nonEmpty"},"digest":{"$ref":"#/$defs/digest"}}},
    "freshness":{"type":"object","additionalProperties":false,"required":["status","inputs","reason"],"properties":{"status":{"enum":["fresh","stale","unavailable","unknown"]},"inputs":{"type":"array","items":{"$ref":"#/$defs/input"}},"reason":{"$ref":"#/$defs/nonEmpty"}}},
    "report":{"type":"object","additionalProperties":false,"required":["version","identity","result","evidence","freshness"],"properties":{"version":{"const":"conformance-report/v1"},"identity":{"type":"object","additionalProperties":false,"required":["id","producer","outputDigest"],"properties":{"id":{"$ref":"#/$defs/nonEmpty"},"producer":{"const":"@archie/conformance"},"outputDigest":{"$ref":"#/$defs/digest"}}},"result":{"type":"object","additionalProperties":false,"required":["code","meaning","status"],"properties":{"code":{"type":"integer","minimum":0,"maximum":3},"meaning":{"enum":["pass","blocking-violation","incomplete-evidence","invalid-input"]},"status":{"enum":["pass","violation","incomplete","invalid"]}}},"evidence":{"type":"object","additionalProperties":false,"required":["realizationMap","contract","graph","provenance"],"properties":{"realizationMap":{"$ref":"#/$defs/digest"},"contract":{"$ref":"#/$defs/digest"},"graph":{"$ref":"#/$defs/digest"},"provenance":{"$ref":"#/$defs/digest"}}},"freshness":{"$ref":"#/$defs/freshness"}}},
    "paths":{"type":"object","additionalProperties":false,"required":["state","graph","summary","map","contract","report","baseline"],"properties":{"state":{"$ref":"#/$defs/nonEmpty"},"graph":{"$ref":"#/$defs/nonEmpty"},"summary":{"$ref":"#/$defs/nonEmpty"},"map":{"$ref":"#/$defs/nonEmpty"},"contract":{"$ref":"#/$defs/nonEmpty"},"report":{"$ref":"#/$defs/nonEmpty"},"baseline":{"$ref":"#/$defs/nonEmpty"}}},
    "state":{"type":"object","additionalProperties":false,"required":["version","identity","checkpoint","paths","evidence"],"properties":{"version":{"const":"onboarding-state/v1"},"identity":{"$ref":"#/$defs/nonEmpty"},"checkpoint":{"enum":["scope-selected","evidence-generated","classification-drafted","proposed-contract-checked","active-contract-checked","baseline-created"]},"paths":{"$ref":"#/$defs/paths"},"evidence":{"type":"object","additionalProperties":false,"patternProperties":{"^(graph|summary|map|contract|report|baseline)$":{"$ref":"#/$defs/digest"}}}}}
  }
}
