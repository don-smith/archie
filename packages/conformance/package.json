{
  "name": "@archie/conformance",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "architecture-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "ARCHITECTURE_CONFORMANCE.md",
    "docs"
  ],
  "scripts": {
    "test": "npm run build --silent --prefix ../.. && npm run test:compiled",
    "test:compiled": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test $(find .test-dist/test -name '*.test.js' -print)"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@archie/runtime": "0.3.0"
  }
}
