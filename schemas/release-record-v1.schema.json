{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.private/schemas/release-record-v1.schema.json",
  "title": "Archie release-record-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "sourceCommit", "authorization", "npm", "apm", "analyzerCompatibility", "htmlDesignSnapshot"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "archie" },
    "version": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "authorization": {
      "type": "object", "additionalProperties": false, "required": ["kind", "claim"],
      "properties": { "kind": { "const": "none" }, "claim": { "const": "locally-reviewed-private-trial" } }
    },
    "npm": { "$ref": "#/$defs/npm" },
    "apm": { "$ref": "#/$defs/apm" },
    "analyzerCompatibility": { "$ref": "#/$defs/analyzer" },
    "htmlDesignSnapshot": { "$ref": "#/$defs/htmlDesignSnapshot" }
  },
  "$defs": {
    "npm": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "version", "locator", "lockIntegrity", "tarballSha256", "requiredPlatformPayload"],
      "properties": {
        "package": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }, "lockIntegrity": { "type": "string", "pattern": "^sha512-" },
        "tarballSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "requiredPlatformPayload": { "type": "string", "minLength": 1 }
      }
    },
    "apm": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "skills", "locator", "ref", "resolvedCommit", "contentHash"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "prefixItems": [
            { "const": "archie" },
            { "const": "architecture-assessment" },
            { "const": "architecture-conformance-onboarding" },
            { "const": "architecture-contracts" },
            { "const": "architecture-docs" },
            { "const": "likec4-authoring" }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "locator": { "type": "string", "pattern": "^git@github\\.com:[^/]+/[^/]+\\.git$" }, "ref": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "resolvedCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }, "contentHash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
      }
    },
    "analyzer": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "typescript", "nodeMajor", "platform", "architecture", "platformPackage", "knownDefects"],
      "properties": {
        "adapter": { "const": "typescript-program-v1" }, "typescript": { "const": "7.0.2" }, "nodeMajor": { "const": 24 },
        "platform": { "const": "darwin" }, "architecture": { "const": "arm64" }, "platformPackage": { "const": "@typescript/typescript-darwin-arm64@7.0.2" },
        "knownDefects": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    },
    "htmlDesignSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "upstream", "commit", "sourcePath", "gitTree", "digest", "license", "requiredNotices", "importToolVersion", "verificationCommand"],
      "properties": {
        "format": { "const": "archie-html-design-snapshot-v1" }, "upstream": { "type": "string", "minLength": 1 }, "commit": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 }, "gitTree": { "type": "string", "minLength": 1 }, "importToolVersion": { "type": "string", "minLength": 1 }, "verificationCommand": { "type": "string", "minLength": 1 },
        "digest": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value", "fileCount"], "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "fileCount": { "type": "integer", "minimum": 1 } } },
        "license": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
        "requiredNotices": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
