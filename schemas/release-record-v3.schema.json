{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archie.private/schemas/release-record-v3.schema.json",
  "title": "Archie release-record-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "sourceCommit",
    "authorization",
    "artifacts",
    "apm",
    "analyzerCompatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "product": {
      "const": "archie"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim"
      ],
      "properties": {
        "kind": {
          "const": "none"
        },
        "claim": {
          "const": "locally-reviewed-private-trial"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/runtimeArtifact"
        },
        {
          "$ref": "#/$defs/conformanceArtifact"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "apm": {
      "$ref": "#/$defs/apm"
    },
    "analyzerCompatibility": {
      "$ref": "#/$defs/analyzer"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "locator",
        "lockIntegrity",
        "tarballSha256",
        "requiredPlatformPayload",
        "dependencies",
        "engines",
        "binaries"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "pattern": "^file:npm/[^/]+\\.tgz$"
        },
        "lockIntegrity": {
          "type": "string",
          "pattern": "^sha512-"
        },
        "tarballSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requiredPlatformPayload": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "engines": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "binaries": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtimeArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "package": {
              "const": "@archie/runtime"
            }
          }
        }
      ]
    },
    "conformanceArtifact": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "properties": {
            "package": {
              "const": "@archie/conformance"
            }
          }
        }
      ]
    },
    "apm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "skills",
        "locator",
        "ref",
        "resolvedCommit",
        "contentHash"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "prefixItems": [
            {
              "const": "archie"
            },
            {
              "const": "architecture-assessment"
            },
            {
              "const": "architecture-conformance-onboarding"
            },
            {
              "const": "architecture-contracts"
            },
            {
              "const": "architecture-docs"
            },
            {
              "const": "architecture-review"
            },
            {
              "const": "html-design"
            },
            {
              "const": "likec4-authoring"
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        },
        "locator": {
          "type": "string",
          "pattern": "^git@github\\.com:[^/]+/[^/]+\\.git$"
        },
        "ref": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "resolvedCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "typescript",
        "nodeMajor",
        "platform",
        "architecture",
        "platformPackage",
        "knownDefects"
      ],
      "properties": {
        "adapter": {
          "const": "typescript-program-v1"
        },
        "typescript": {
          "const": "7.0.2"
        },
        "nodeMajor": {
          "const": 24
        },
        "platform": {
          "const": "darwin"
        },
        "architecture": {
          "const": "arm64"
        },
        "platformPackage": {
          "const": "@typescript/typescript-darwin-arm64@7.0.2"
        },
        "knownDefects": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
